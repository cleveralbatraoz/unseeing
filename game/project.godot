; Unseeing — Godot 4 project.
; Compatibility renderer is REQUIRED: it is the only renderer that works in the
; Web (wasm) export, and this game targets web + native from one codebase.
config_version=5

[application]

config/name="Unseeing"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/inference_on_variant=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

; The vendored test bench is pinned by ci/gdunit4.lock; its in-editor updater
; would poll GitHub on every project open and, on one click, delete
; res://addons/gdUnit4/ and unpack an unreviewed release over it. Upstream
; checks this flag before opening the connection, so off here means no call.
; Version bumps go through ci/vendor-gdunit4.sh update <tag> instead.
settings/common/update_notification_enabled=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
; Required by the arm64/universal macOS export; the game ships no textures
; beyond the icon, so the import cost is nil.
textures/vram_compression/import_etc2_astc=true
